datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
  output   = "../generated/sqlite"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  role         String   @default("SALES") // ADMIN, DIRECTOR, SALES, MARKETING, DESIGN, ADS
  actorType    String   @default("USER")  // 3 tác nhân chuẩn ATTT: ADMIN, DIRECTOR, USER
  department   String   @default("SALES") // Phòng ban của USER do Admin tạo/quản lý (SALES, MARKETING, DESIGN, ADS, ...)
  position     String   @default("Nhân viên") // Chức vụ: Nhân viên, Trưởng nhóm, Phó phòng, Trưởng phòng, Trưởng ban, Giám đốc
  appointedDecisionCode String? // Mã thông báo chúc mừng / quyết định bổ nhiệm của Giám đốc ký
  initials     String   @default("TT")
  avatar       String?
  address      String?  // Nơi trú hiện tại
  hometown     String?  // Quê quán
  achievements String?  // Thành tích, giải thưởng, dự án tiêu biểu
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedLeads       Lead[]           @relation("AssignedSales")
  createdLeads        Lead[]           @relation("CreatedByUser")
  statusChanges       LeadStatusHistory[]
  assignmentsGiven    LeadAssignment[] @relation("AssignmentsGiven")
  assignmentsReceived LeadAssignment[] @relation("AssignmentsReceived")
  assignedByActions   LeadAssignment[] @relation("AssignedBy")
  attachmentsUploaded LeadAttachment[]
  auditLogs           AuditLog[]
  departmentReports   DepartmentReport[]
  departmentReportReads DepartmentReportRead[]
  notificationReads   NotificationRead[]
  promotionsReceived  PromotionDecision[] @relation("PromotionTargetUser")
  promotionsSigned    PromotionDecision[] @relation("PromotionSignedDirector")
  promotionsApplied   PromotionDecision[] @relation("PromotionAppliedAdmin")
  leadActivities      LeadActivity[]      @relation("LeadActivityAuthor")
  leadQuotes          LeadQuote[]         @relation("LeadQuoteAuthor")

  @@index([role])
  @@index([actorType])
  @@index([department])
  @@index([email])
}

model Department {
  id          String   @id @default(cuid())
  code        String   @unique // VD: SALES, MARKETING, DESIGN, ADS, TECH_LED...
  name        String   @unique // VD: Phòng Kinh Doanh, Phòng Thiết Kế...
  description String?
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PromotionDecision {
  id               String    @id @default(cuid())
  code             String    @unique // VD: TB-BGD-2610-01
  title            String    // Tiêu đề thông báo chúc mừng / Quyết định bổ nhiệm
  content          String    // Nội dung chúc mừng và giao nhiệm vụ của Giám đốc
  targetUserId     String
  targetDepartment String    // Phòng ban bổ nhiệm
  newPosition      String    // Trưởng phòng, Trưởng ban, Phó phòng, Trưởng nhóm
  signedById       String    // Giám đốc (DIRECTOR) ký ban hành
  signedByName     String    // Họ tên Giám đốc ký
  status           String    @default("SIGNED_BY_DIRECTOR") // SIGNED_BY_DIRECTOR, APPLIED_BY_ADMIN, REVOKED
  appliedByAdminId String?
  signedAt         DateTime  @default(now())
  appliedAt        DateTime?
  createdAt        DateTime  @default(now())

  targetUser       User      @relation("PromotionTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  signedBy         User      @relation("PromotionSignedDirector", fields: [signedById], references: [id])
  appliedByAdmin   User?     @relation("PromotionAppliedAdmin", fields: [appliedByAdminId], references: [id])

  @@index([targetUserId])
  @@index([status])
  @@index([createdAt])
}

model ProductCategory {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String   @unique
  description     String?
  group           String   @default("LED_SCREEN") // LED_SCREEN, ELECTRONIC_BOARD, OTHER
  sortOrder       Int      @default(100)
  allowCustomText Boolean  @default(false)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  leads Lead[]

  @@index([group])
  @@index([sortOrder])
}

model Lead {
  id                  String   @id @default(cuid())
  code                String   @unique // Ví dụ: TT-LED-2401
  customerName        String
  companyName         String   @default("")
  phone               String
  normalizedPhone     String?
  email               String?
  installationAddress String?
  location            String   @default("")
  product             String   @default("Chưa xác định")
  productCustomText   String?
  demandType          String?  // Hỏi sửa chữa, Không cung cấp thông tin, Hỏi sản phẩm đặc biệt, Hỏi thuê, Không đúng nhu cầu
  categoryId          String
  source              String   @default("Hotline") // Hotline, Form, Email, Facebook Ads, Google Ads, Website, Giới thiệu, Triển lãm
  contactChannel      String?  // Hotline, Điền form, Email, Zalo, Facebook...
  status              String   @default("Vừa nhận thông tin") // Vừa nhận thông tin, Đang soạn báo giá, Đã gửi báo giá, Chốt thành công, Thất bại
  failureReason       String?  // Bắt buộc nếu status = Thất bại
  quoteSentAt         DateTime?
  customerRespondedAt DateTime?
  customerResponseNote String?
  estimatedValue      String?  @default("Đang khảo sát")
  notes               String?

  // Enterprise Lead Management (SLA, Lead Scoring, LED Sizing & Director Pricing Approval)
  priorityScore          Int       @default(50)     // 0 - 100
  priorityTier           String    @default("WARM") // HOT, WARM, COLD
  nextFollowUpAt         DateTime?                  // Thời hạn SLA / lịch hẹn chăm sóc kế tiếp
  nextActionNote         String?                    // Việc cần làm tiếp theo (VD: Gọi lại, Khảo sát mặt bằng...)
  lastContactedAt        DateTime?                  // Thời điểm tương tác gần nhất
  ledWidth               Float?                     // Chiều ngang màn hình LED (m)
  ledHeight              Float?                     // Chiều cao màn hình LED (m)
  ledModuleType          String?                    // Dòng module LED (VD: P2.5 Indoor, P3 Outdoor...)
  discountPercent        Float?    @default(0)      // Mức chiết khấu đề xuất (%)
  directorApprovalStatus String    @default("NONE") // NONE, PENDING, APPROVED, REJECTED
  directorApprovedByName String?
  directorApprovalNote   String?

  salesPersonId       String?
  createdById         String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  category            ProductCategory     @relation(fields: [categoryId], references: [id])
  salesPerson         User?               @relation("AssignedSales", fields: [salesPersonId], references: [id])
  createdBy           User?               @relation("CreatedByUser", fields: [createdById], references: [id])

  statusHistory       LeadStatusHistory[]
  assignments         LeadAssignment[]
  attachments         LeadAttachment[]
  trackingEvents      TrackingEvent[]
  auditLogs           AuditLog[]
  activities          LeadActivity[]
  quotes              LeadQuote[]

  @@index([phone])
  @@index([normalizedPhone])
  @@index([email])
  @@index([customerName])
  @@index([companyName])
  @@index([status])
  @@index([source])
  @@index([demandType])
  @@index([quoteSentAt])
  @@index([customerRespondedAt])
  @@index([priorityTier])
  @@index([nextFollowUpAt])
  @@index([directorApprovalStatus])
  @@index([salesPersonId])
  @@index([createdAt])
}

model LeadStatusHistory {
  id          String   @id @default(cuid())
  leadId      String
  fromStatus  String?
  toStatus    String
  reason      String?  // Bắt buộc nếu toStatus = Thất bại
  changedById String?
  createdAt   DateTime @default(now())

  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  changedBy   User?    @relation(fields: [changedById], references: [id])

  @@index([leadId])
  @@index([toStatus])
  @@index([createdAt])
}

model LeadAssignment {
  id           String   @id @default(cuid())
  leadId       String
  fromSalesId  String?
  toSalesId    String
  reason       String?  // Lý do chuyển bàn giao
  assignedById String?
  createdAt    DateTime @default(now())

  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  fromSales    User?    @relation("AssignmentsGiven", fields: [fromSalesId], references: [id])
  toSales      User     @relation("AssignmentsReceived", fields: [toSalesId], references: [id])
  assignedBy   User?    @relation("AssignedBy", fields: [assignedById], references: [id])

  @@index([leadId])
  @@index([toSalesId])
  @@index([createdAt])
}

model LeadAttachment {
  id           String   @id @default(cuid())
  leadId       String
  fileName     String
  fileUrl      String
  fileSize     Int?
  fileType     String   @default("IMAGE") // IMAGE, DRAWING, DOCUMENT
  uploadedById String?
  createdAt    DateTime @default(now())

  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])

  @@index([leadId])
}

model TrackingEvent {
  id             String   @id @default(cuid())
  eventKey       String?  @unique
  leadId         String?
  websiteSource  String   @default("")
  source         String   @default("")
  medium         String   @default("")
  contactChannel String?
  campaign       String?
  landingPage    String   @default("")
  utmParams      String?  // JSON string
  device         String?
  ipAddress      String?
  location       String?
  createdAt      DateTime @default(now())

  lead           Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([websiteSource])
  @@index([source])
  @@index([createdAt])
}

model MarketingCampaign {
  id          String   @id @default(cuid())
  code        String   @unique
  name        String
  platform    String   // Google Ads, Facebook Ads, SEO
  status      String   @default("Active") // Active, Paused, Completed
  budget      Float    @default(0)
  spent       Float    @default(0)
  startDate   DateTime @default(now())
  endDate     DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  performances AdsPerformance[]

  @@index([platform])
  @@index([status])
}

model AdsPerformance {
  id           String            @id @default(cuid())
  campaignId   String
  date         DateTime          @default(now())
  impressions  Int               @default(0)
  clicks       Int               @default(0)
  cost         Float             @default(0)
  conversions  Int               @default(0)
  cpc          Float             @default(0)
  ctr          Float             @default(0)

  campaign     MarketingCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId])
  @@index([date])
}

model KeywordMetric {
  id           String   @id @default(cuid())
  keyword      String
  impressions  Int      @default(0)
  clicks       Int      @default(0)
  avgCpc       Float    @default(0)
  avgPosition  Float    @default(1.0)
  searchVolume Int      @default(0)
  source       String   @default("Google Ads") // Google Ads, Google Search Console
  date         DateTime @default(now())

  @@index([keyword])
  @@index([source])
}

model SyncJob {
  id            String    @id @default(cuid())
  service       String    // GOOGLE_ADS, GA4, SEARCH_CONSOLE
  status        String    @default("CONNECTED") // CONNECTED, SYNCING, COMPLETED, ERROR, NOT_CONFIGURED
  lastSyncTime  DateTime?
  recordsSynced Int       @default(0)
  errorMessage  String?
  createdAt     DateTime  @default(now())

  @@index([service])
}

model BrandSetting {
  id                String   @id @default("default_brand")
  brandName         String   @default("TOÀN TRUNG")
  slogan            String   @default("Giải pháp hiển thị màn hình LED & Viễn thông chuyên nghiệp")
  logoUrl           String   @default("/logo.png")
  faviconUrl        String   @default("/favicon.ico")
  primaryColor      String   @default("#2563EB")
  supportHotline    String   @default("0909.123.456")
  loginWelcomeTitle String   @default("Chào mừng trở lại")
  loginWelcomeDesc  String   @default("")
  loginBgUrl        String   @default("")
  updatedAt         DateTime @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  leadId    String?
  action    String   // CREATE_LEAD, UPDATE_LEAD, CHANGE_STATUS, ASSIGN_SALES, LOGIN, LOGOUT, BRAND_UPDATE
  entity    String   // LEAD, USER, AUTH, BRAND
  entityId  String?
  details   String?  // JSON string
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id])
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([leadId])
  @@index([action])
  @@index([createdAt])
}

model DepartmentReport {
  id             String   @id @default(cuid())
  title          String
  content        String
  department     String
  attachmentName String?
  attachmentUrl  String?
  createdById    String
  createdAt      DateTime @default(now())

  createdBy User                  @relation(fields: [createdById], references: [id])
  reads     DepartmentReportRead[]

  @@index([createdAt])
  @@index([department])
}

model DepartmentReportRead {
  id        String   @id @default(cuid())
  reportId  String
  userId    String
  readAt    DateTime @default(now())

  report DepartmentReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reportId, userId])
  @@index([userId])
}

model LeadActivity {
  id             String    @id @default(cuid())
  leadId         String
  type           String    @default("CALL") // CALL, ZALO, SURVEY, MEETING, QUOTATION, NOTE
  summary        String
  outcome        String?
  nextFollowUpAt DateTime?
  createdById    String?
  createdAt      DateTime  @default(now())

  lead           Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy      User?     @relation("LeadActivityAuthor", fields: [createdById], references: [id])

  @@index([leadId])
  @@index([createdAt])
}

model LeadQuote {
  id                  String   @id @default(cuid())
  code                String   @unique // VD: BG-TT-2610-001
  leadId              String
  moduleSpec          String   // VD: Màn hình LED P2.5 Indoor Hội trường
  widthMeters         Float
  heightMeters        Float
  areaSqm             Float
  unitPriceVnd        Float
  processorVnd        Float    @default(0)
  structureInstallVnd Float    @default(0)
  discountPercent     Float    @default(0)
  totalVnd            Float
  warrantyMonths      Int      @default(24)
  notes               String?
  status              String   @default("SENT") // DRAFT, SENT, PENDING_DIRECTOR, DIRECTOR_APPROVED
  approvedByName      String?
  createdById         String?
  createdAt           DateTime @default(now())

  lead                Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  createdBy           User?    @relation("LeadQuoteAuthor", fields: [createdById], references: [id])

  @@index([leadId])
  @@index([createdAt])
}

model NotificationRead {
  id              String   @id @default(cuid())
  notificationKey String
  userId          String
  readAt          DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([notificationKey, userId])
  @@index([userId])
}
