{
  "name": "toan-trung-marketing-workspace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend",
    "database"
  ],
  "scripts": {
    "predev": "node scripts/predev.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace @toantrung/web",
    "dev:api": "npm run dev --workspace @toantrung/api",
    "build": "node scripts/cloud-build.mjs",
    "start": "node scripts/cloud-start.mjs",
    "start:web": "npm run start --workspace @toantrung/web",
    "start:api": "npm run start --workspace @toantrung/api",
    "build:web": "npm run build --workspace @toantrung/web",
    "build:api": "npm run build --workspace @toantrung/api",
    "db:generate": "npm run db:generate --workspace @toantrung/database",
    "db:push": "npm run db:push --workspace @toantrung/database",
    "db:save-test": "node database/scripts/export-test-data.mjs",
    "check:arch": "node scripts/check-architecture.mjs",
    "typecheck": "tsc -p frontend/tsconfig.json --noEmit && tsc -p backend/tsconfig.json --noEmit",
    "test": "node scripts/run-tests.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "allowScripts": {
    "@prisma/client@5.22.0": true,
    "@prisma/engines@5.22.0": true,
    "prisma@5.22.0": true
  }
}
